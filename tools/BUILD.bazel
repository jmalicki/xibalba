"""
Developer tools and convenience scripts
"""

# Shellcheck linting as a Bazel test (runs in CI)
# Uses Bazel-managed shellcheck (hermetic, no system install needed)
sh_test(
    name = "shellcheck_test",
    srcs = ["run_shellcheck.sh"],
    data = ["@shellcheck//:shellcheck-v0.9.0/shellcheck"],
    tags = ["lint", "manual", "local"],  # local = no sandbox (needs source access)
    size = "small",
)

# Optional: Install pre-commit git hooks for local development
# This uses system pipx/pre-commit if available
sh_binary(
    name = "setup_precommits",
    srcs = ["setup_precommits.sh"],
    visibility = ["//visibility:public"],
)

