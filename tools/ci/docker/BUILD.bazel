# Xibalba CI Dev Environment (rules_distroless approach)
#
# Hermetic dev environment using rules_distroless for apt packages

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push", "oci_tarball")

# ============================================================================
# Lock File Management
# ============================================================================

# Update lock file when packages.yaml changes
# Usage: bazel run @ubuntu_packages//:lock (can't alias due to visibility)

exports_files([
    "Dockerfile",
    "packages.yaml",
    "packages.lock.json",
])

# ============================================================================
# OCI Images with apt packages
# ============================================================================

# CI build environment (ONLY for compiling Xibalba, not testing)
# Filesystem tools are in QEMU VMs, not in this container
oci_image(
    name = "xibalba_dev_env",
    base = "@ubuntu_base",  # Ubuntu 24.04 has libc already
    tars = [
        # System essentials
        "@ubuntu_packages//bash/amd64:data",
        "@ubuntu_packages//coreutils/amd64:data",
        "@ubuntu_packages//findutils/amd64:data",
        
        # Build tools (to compile Xibalba)
        "@ubuntu_packages//clang-18/amd64:data",
        "@ubuntu_packages//libclang-cpp18/amd64:data",
        "@ubuntu_packages//libllvm18/amd64:data",
        "@ubuntu_packages//libedit2/amd64:data",
        "@ubuntu_packages//libbpf-dev/amd64:data",
        "@ubuntu_packages//libelf-dev/amd64:data",
        "@ubuntu_packages//linux-headers-generic/amd64:data",
        
        # Utilities (for CI scripts)
        "@ubuntu_packages//jq/amd64:data",
        "@ubuntu_packages//libjq1/amd64:data",
        "@ubuntu_packages//libonig5/amd64:data",
        "@ubuntu_packages//curl/amd64:data",
        "@ubuntu_packages//ca-certificates/amd64:data",
    ],
    entrypoint = ["/usr/bin/bash"],
)

# Tarball for local testing
oci_tarball(
    name = "xibalba_dev_env_tarball",
    image = ":xibalba_dev_env",
    repo_tags = ["xibalba-dev:local"],
)

# Push to GitHub Container Registry
oci_push(
    name = "push_dev_env",
    image = ":xibalba_dev_env",
    repository = "ghcr.io/jmalicki/xibalba-dev-env",
    remote_tags = ["latest"],
)

# ============================================================================
# Utilities
# ============================================================================

# Generate cache key from lock files
sh_binary(
    name = "generate_cache_key",
    srcs = ["generate_cache_key.sh"],
    args = [
        "$(location //:MODULE.bazel.lock)",
        "$(location :packages.lock.json)",
    ],
    data = [
        "//:MODULE.bazel.lock",
        ":packages.lock.json",
    ],
)

