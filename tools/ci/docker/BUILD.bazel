# Xibalba CI Dev Environment (rules_distroless approach)
#
# Hermetic dev environment using rules_distroless for apt packages

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push", "oci_tarball")
load("@rules_distroless//distroless:defs.bzl", "flatten")

# ============================================================================
# Lock File Management
# ============================================================================

exports_files([
    "packages.yaml",
    "packages.lock.json",
])

# ============================================================================
# Download and install Bazelisk
# ============================================================================

# Download Bazel (not Bazelisk) and create a tar layer
genrule(
    name = "bazelisk_layer",
    outs = ["bazelisk.tar.gz"],
    cmd = """
        mkdir -p tmp/usr/local/bin
        # Download the actual Bazel binary (not Bazelisk)
        wget -q -O tmp/usr/local/bin/bazel \
          https://releases.bazel.build/8.4.2/release/bazel-8.4.2-linux-x86_64
        chmod +x tmp/usr/local/bin/bazel
        tar -C tmp -czf $@ ./usr/local/bin/bazel
        rm -rf tmp
    """,
    tags = ["requires-network"],
)

# ============================================================================
# Strip ./ prefix from flat layer to avoid conflicts with ubuntu_base
# ============================================================================

# Reprocess the flat tar to remove ./ prefix that conflicts with ubuntu_base
# AND run update-ca-certificates to generate cert bundle
genrule(
    name = "flat_no_prefix",
    srcs = ["@ubuntu_packages//:flat"],
    outs = ["flat_no_prefix.tar"],
    cmd = """
        mkdir -p tmp
        tar -xf $(location @ubuntu_packages//:flat) -C tmp
        
        # Generate ca-certificates bundle (rules_distroless doesn't run postinst scripts)
        # Manually create the cert bundle by concatenating all certs
        mkdir -p tmp/etc/ssl/certs
        if [ -d tmp/usr/share/ca-certificates ]; then
            find tmp/usr/share/ca-certificates -name '*.crt' -exec cat {} \\; > tmp/etc/ssl/certs/ca-certificates.crt 2>/dev/null || true
        fi
        
        # NOTE: mergedusr=True in MODULE.bazel handles /lib -> /usr/lib normalization
        
        # Create clang/clang++ symlinks (genrules use hardcoded 'clang', not 'clang-18')
        ln -sf clang-18 tmp/usr/bin/clang
        ln -sf clang++-18 tmp/usr/bin/clang++
        
        tar -C tmp -cf $@ --transform='s|^\\./||' .
        rm -rf tmp
    """,
)

# ============================================================================
# OCI Images with apt packages
# ============================================================================

# CI build environment (ONLY for compiling Xibalba, not testing)
oci_image(
    name = "xibalba_dev_env",
    base = "@ubuntu_base",  # Ubuntu 24.04 base
    tars = [
        ":flat_no_prefix",  # Flattened packages with ./ prefix stripped
        ":bazelisk_layer",  # Bazelisk binary
    ],
    env = {
        "CC": "clang-18",
        "CXX": "clang++-18",
        "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    },
)

# Tarball for local testing
oci_tarball(
    name = "xibalba_dev_env_tarball",
    image = ":xibalba_dev_env",
    repo_tags = ["xibalba-dev:local"],
)

# Script to push container to GitHub Container Registry
sh_binary(
    name = "push_to_ghcr",
    srcs = ["push_to_ghcr.sh"],
    data = [
        ":xibalba_dev_env_tarball",
        "//:MODULE.bazel.lock",
        ":packages.lock.json",
    ],
)

# Push to GitHub Container Registry
oci_push(
    name = "push_dev_env",
    image = ":xibalba_dev_env",
    repository = "ghcr.io/jmalicki/xibalba-dev-env",
    remote_tags = ["latest"],
)

# ============================================================================
# Utilities
# ============================================================================

# Generate cache key from lock files
sh_binary(
    name = "generate_cache_key",
    srcs = ["generate_cache_key.sh"],
    args = [
        "$(location //:MODULE.bazel.lock)",
        "$(location :packages.lock.json)",
    ],
    data = [
        "//:MODULE.bazel.lock",
        ":packages.lock.json",
    ],
)
