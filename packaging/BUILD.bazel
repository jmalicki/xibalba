# Xibalba Debian Package
#
# Creates .deb packages for easy installation in VMs

package(default_visibility = ["//visibility:public"])

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Tar archive of binaries
pkg_tar(
    name = "xibalba-bin",
    srcs = [
        "//chaos:pause_controller",
        "//chaos:simple_chaos_test",
        "//chaos:pause_injector_bpf",
    ],
    mode = "0755",
    package_dir = "/usr/bin",
    strip_prefix = "/chaos",
)

# Tar archive of data files (eBPF bytecode)
pkg_tar(
    name = "xibalba-data",
    srcs = [
        "//chaos:pause_injector_bpf",
    ],
    mode = "0644",
    package_dir = "/usr/share/xibalba",
    strip_prefix = "/chaos",
)

# Debian package
pkg_deb(
    name = "xibalba-deb",
    architecture = "amd64",
    data = ":xibalba-bin",
    depends = [
        "libbpf0",
        "libelf1",
    ],
    recommends = [
        "e2fsprogs",      # ext4
        "xfsprogs",       # XFS
        "btrfs-progs",    # btrfs
        "f2fs-tools",     # F2FS
        "nilfs-tools",    # NILFS2
        "nfs-common",     # NFS client
    ],
    suggests = [
        "zfsutils-linux",  # ZFS (may need contrib repo)
        "nfs-kernel-server",  # NFS server
        "exfatprogs",      # exFAT
        "ntfs-3g",         # NTFS
        "cifs-utils",      # CIFS/SMB
        "fuse3",           # FUSE filesystems
    ],
    description = """Xibalba: Chaos Testing Framework for Kernel Filesystems
 Xibalba is a Jepsen-inspired chaos testing framework for Linux kernel VFS
 operations, specifically designed to test concurrent filesystem operations
 using eBPF fault injection.
 .
 Named after the Maya underworld of trials, Xibalba puts your code through
 a gauntlet of chaos tests to prove its worthiness for production.
 .
 This package includes:
  - pause_controller: eBPF userspace controller
  - simple_chaos_test: Multi-threaded directory reading test
  - pause_injector.bpf.o: eBPF bytecode for fault injection
 .
 For comprehensive filesystem testing, install recommended packages for
 ext4, XFS, btrfs, F2FS, NILFS2, and NFS. ZFS testing requires zfsutils-linux
 from the contrib repository.""",
    homepage = "https://github.com/your-org/xibalba",
    maintainer = "Xibalba Developers <xibalba@example.com>",
    package = "xibalba",
    version = "0.1.0",
)

# Convenience alias for building the package
alias(
    name = "package",
    actual = ":xibalba-deb",
)

