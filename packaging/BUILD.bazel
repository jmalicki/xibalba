# Xibalba Debian Package
#
# Creates .deb packages for easy installation in VMs

package(default_visibility = ["//visibility:public"])

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Tar archive of test binaries
pkg_tar(
    name = "xibalba-test-bins",
    srcs = [
        "//chaos:pause_controller",
        "//chaos:simple_chaos_test",
    ],
    mode = "0755",
    package_dir = "/usr/bin",
    strip_prefix = "/chaos",
)

# Copy and rename test-runner.sh to xibalba-test-runner
genrule(
    name = "copy_test_runner",
    srcs = ["//vm:test-runner.sh"],
    outs = ["xibalba-test-runner"],
    cmd = "cp $< $@",
)

# Copy and rename xibalba-gauntlet.sh to xibalba-gauntlet
genrule(
    name = "copy_gauntlet",
    srcs = ["//vm:xibalba-gauntlet.sh"],
    outs = ["xibalba-gauntlet"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_smoke_test",
    srcs = ["//vm:xibalba-smoke-test.sh"],
    outs = ["xibalba-smoke-test"],
    cmd = "cp $< $@",
)

# Tar archive of test runner script
pkg_tar(
    name = "xibalba-test-runner-tar",
    srcs = [":copy_test_runner"],
    mode = "0755",
    package_dir = "/usr/bin",
)

# Tar archive of gauntlet script
pkg_tar(
    name = "xibalba-gauntlet-tar",
    srcs = [":copy_gauntlet"],
    mode = "0755",
    package_dir = "/usr/bin",
)

pkg_tar(
    name = "xibalba-smoke-test-tar",
    srcs = [":copy_smoke_test"],
    mode = "0755",
    package_dir = "/usr/bin",
)

# Combined binaries
pkg_tar(
    name = "xibalba-bin",
    deps = [
        ":xibalba-test-bins",
        ":xibalba-test-runner-tar",
        ":xibalba-gauntlet-tar",
        ":xibalba-smoke-test-tar",
    ],
)

# Tar archive of data files (eBPF bytecode)
pkg_tar(
    name = "xibalba-data",
    srcs = [
        "//chaos:pause_injector_bpf",
    ],
    mode = "0644",
    package_dir = "/usr/share/xibalba",
    strip_prefix = "/chaos",
)

# Debian package
pkg_deb(
    name = "xibalba-deb",
    architecture = "amd64",
    data = ":xibalba-bin",
    depends = [
        "libbpf1",  # Ubuntu 24.04+ uses libbpf1 (version 1.x)
        "libelf1",
    ],
    recommends = [
        "e2fsprogs",       # ext4
        "xfsprogs",        # XFS
        "btrfs-progs",     # btrfs
        "zfsutils-linux",  # ZFS (primary test target with ext4)
        "f2fs-tools",      # F2FS
        "nilfs-tools",     # NILFS2
        "nfs-common",      # NFS client
        "exfatprogs",      # exFAT (common on USB drives, SD cards)
        "ntfs-3g",         # NTFS (common for dual-boot, external drives)
    ],
    suggests = [
        "nfs-kernel-server",  # NFS server (only for server testing)
        "cifs-utils",         # CIFS/SMB (network filesystems)
        "fuse3",              # FUSE filesystems (user-space implementations)
    ],
    description = """Xibalba: Chaos Testing Framework for Kernel Filesystems
 Xibalba is a Jepsen-inspired chaos testing framework for Linux kernel VFS
 operations, specifically designed to test concurrent filesystem operations
 using eBPF fault injection.
 .
 Named after the Maya underworld of trials, Xibalba puts your code through
 a gauntlet of chaos tests to prove its worthiness for production.
 .
This package includes:
 - pause_controller: eBPF userspace controller
 - simple_chaos_test: Multi-threaded directory reading test
 - xibalba-test-runner: Single filesystem test automation
 - xibalba-gauntlet: Progressive consistency testing (all filesystems)
 - pause_injector.bpf.o: eBPF bytecode for fault injection
 .
 For comprehensive filesystem testing, recommended packages include tools
 for ext4, XFS, btrfs, ZFS, F2FS, NILFS2, and NFS. These are automatically
 installed when using 'apt install' (but not 'dpkg -i').""",
    homepage = "https://github.com/your-org/xibalba",
    maintainer = "Xibalba Developers <xibalba@example.com>",
    package = "xibalba",
    version = "0.1.0",
)

# Build dependencies (needed to compile Xibalba)
# These are the -dev packages corresponding to the runtime depends
BUILD_DEPS = [
    "llvm",              # For llvm-objdump (eBPF verification)
    "libbpf-dev",        # Development files for libbpf
    "libelf-dev",        # Development files for libelf
    "linux-headers-generic",  # Kernel headers for eBPF compilation
]

# Generate build-deps.txt for CI consumption
genrule(
    name = "generate_build_deps",
    outs = ["build-deps.txt"],
    cmd = "echo '# Xibalba build dependencies' > $@ && echo '# Generated from packaging/BUILD.bazel - DO NOT EDIT' >> $@ && echo '' >> $@ && " +
          " && ".join(["echo '%s' >> $@" % dep for dep in BUILD_DEPS]),
    visibility = ["//visibility:public"],
)

# Convenience alias for building the package
alias(
    name = "package",
    actual = ":xibalba-deb",
)

