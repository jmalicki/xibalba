# RUDRA Debian Package
#
# Creates .deb packages for easy installation in VMs

package(default_visibility = ["//visibility:public"])

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Tar archive of binaries
pkg_tar(
    name = "rudra-bin",
    srcs = [
        "//chaos:pause_controller",
        "//chaos:simple_chaos_test",
        "//chaos:pause_injector_bpf",
    ],
    mode = "0755",
    package_dir = "/usr/bin",
    strip_prefix = "/chaos",
)

# Tar archive of data files (eBPF bytecode)
pkg_tar(
    name = "rudra-data",
    srcs = [
        "//chaos:pause_injector_bpf",
    ],
    mode = "0644",
    package_dir = "/usr/share/rudra",
    strip_prefix = "/chaos",
)

# Debian package
pkg_deb(
    name = "rudra-deb",
    architecture = "amd64",
    data = ":rudra-bin",
    depends = [
        "libbpf0",
        "libelf1",
    ],
    description = """RUDRA: Chaos Testing Framework for Kernel Filesystems
 RUDRA is a Jepsen-inspired chaos testing framework for Linux kernel VFS
 operations, specifically designed to test concurrent filesystem operations
 using eBPF fault injection.
 .
 This package includes:
  - pause_controller: eBPF userspace controller
  - simple_chaos_test: Multi-threaded directory reading test
  - pause_injector.bpf.o: eBPF bytecode for fault injection""",
    homepage = "https://github.com/your-org/rudra",
    maintainer = "RUDRA Developers <rudra@example.com>",
    package = "rudra",
    version = "0.1.0",
)

# Convenience target: build and output .deb to dist/
genrule(
    name = "package",
    srcs = [":rudra-deb"],
    outs = ["rudra_0.1.0_amd64.deb"],
    cmd = "cp $(location :rudra-deb) $@",
    output_to_bindir = True,
)

