# ============================================================================
# Unit Tests
# ============================================================================

cc_test(
    name = "registry_test",
    srcs = ["registry_test.cc"],
    deps = [
        ":registry",
        "@googletest//:gtest_main",
    ],
    copts = [
        "-Wno-unused-parameter",
    ],
    size = "small",
)

# BPF program tests using BPF_PROG_TEST_RUN
cc_test(
    name = "bpf_test",
    srcs = ["bpf_test.cc"],
    deps = [
        "@googletest//:gtest_main",
    ],
    data = [
        "//chaos:pause_injector_bpf",  # The working BPF program
        ":rename_tracepoint_bpf",      # NEW: Tracepoint injector
        ":link_tracepoint_bpf",        # NEW: Link tracepoint injector
    ],
    linkopts = [
        "-lbpf",
        "-lelf",
        "-lz",
    ],
    copts = [
        "-Wno-unused-parameter",
        "-Wno-format-nonliteral",
    ],
    size = "small",
    tags = ["requires-bpf"],  # Can skip on systems without BPF support
)

