# VM Infrastructure for Xibalba Testing
#
# These scripts create, manage, and test VMs for kernel filesystem testing.
# Run them via Bazel to ensure proper dependency tracking and hermetic execution.

package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

# Automated test runner (gets installed in VMs as /usr/bin/xibalba-test-runner)
sh_binary(
    name = "test_runner_script",
    srcs = ["test-runner.sh"],
    data = [],
)

# Gauntlet test runner - progressive consistency testing across all filesystems
sh_binary(
    name = "gauntlet_script",
    srcs = ["xibalba-gauntlet.sh"],
    data = [],
)

# Parallel VM test runner - runs multiple VMs with different filesystems simultaneously
# Wrapper script that passes the package path to the test script
sh_binary(
    name = "parallel_vm_tests",
    srcs = ["run-parallel-vm-tests-wrapper.sh"],
    args = ["$(location //packaging:xibalba-deb)"],
    data = [
        ":run-parallel-vm-tests.sh",
        ":create_test_vm.sh",
        ":deploy_xibalba.sh",
        ":run_tests.sh",
        ":destroy_vm.sh",
        ":check_prerequisites.sh",
        "//packaging:xibalba-deb",
    ],
)

# Check if host has required VM tools (QEMU/KVM, libvirt, etc.)
sh_binary(
    name = "check_prerequisites",
    srcs = ["check_prerequisites.sh"],
    # This can run standalone, no dependencies
)

# Create a test VM
# Usage: bazel run //vm:create_vm -- --name test-01 [--memory 4096] [--cpus 2]
sh_binary(
    name = "create_vm",
    srcs = ["create_test_vm.sh"],
    data = [
        # Will need cloud-init configs, kernel images, etc.
        # Add as we create them
    ],
)

# Deploy Xibalba binaries to a running VM
# Usage: bazel run //vm:deploy_xibalba -- <vm-name>
sh_binary(
    name = "deploy_xibalba",
    srcs = ["deploy_xibalba.sh"],
    data = [
        "//chaos:pause_controller",
        "//chaos:pause_injector_bpf",
        "//chaos:simple_chaos_test",
    ],
    # The script will copy binaries from bazel-bin/ to VM
)

# Run Xibalba tests inside a VM
# Usage: bazel run //vm:run_tests -- <vm-name>
sh_binary(
    name = "run_tests",
    srcs = ["run_tests.sh"],
    # Depends on deploy_xibalba being run first
)

# Destroy a test VM
# Usage: bazel run //vm:destroy_vm -- <vm-name>
sh_binary(
    name = "destroy_vm",
    srcs = ["destroy_vm.sh"],
)

