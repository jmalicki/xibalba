# VM Infrastructure for Xibalba Testing
#
# Bazel-native VM testing: each filesystem gets its own test target,
# Bazel handles parallelism and result aggregation automatically.

package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load(":vm_tests.bzl", "vm_gauntlet_suite")

# === Gauntlet Tests (Bazel-native parallelism) ===

# Individual filesystem tests (run in parallel automatically)
vm_gauntlet_suite(
    name = "filesystem_gauntlet_tests",
    filesystems = ["ext4", "zfs"],
)

# === Test Scripts (installed in VMs) ===

sh_binary(
    name = "test_runner_script",
    srcs = ["test-runner.sh"],
    data = [],
)

sh_binary(
    name = "gauntlet_script",
    srcs = ["xibalba-gauntlet.sh"],
    data = [],
)

# === Legacy Parallel Test (bash-based, will be deprecated) ===

sh_test(
    name = "parallel_vm_tests_validated",
    srcs = ["run_vm_tests_validated.sh"],
    args = ["$(location //packaging:xibalba-deb)"],
    data = [
        ":verify_host_deps.sh",
        ":run-parallel-vm-tests-wrapper.sh",
        ":run-parallel-vm-tests.sh",
        ":create_test_vm.sh",
        ":deploy_xibalba.sh",
        ":run_tests.sh",
        ":destroy_vm.sh",
        "//packaging:xibalba-deb",
    ],
    tags = ["manual", "local", "requires-kvm", "legacy"],
    size = "large",
    timeout = "long",
)

# === Quick Smoke Test ===

sh_test(
    name = "vm_smoke_test",
    srcs = ["run-vm-smoke-test.sh"],
    args = ["$(location //packaging:xibalba-deb)"],
    data = [
        ":verify_host_deps.sh",
        ":create_test_vm.sh",
        ":deploy_xibalba.sh",
        ":xibalba-smoke-test.sh",
        ":destroy_vm.sh",
        "//packaging:xibalba-deb",
    ],
    tags = ["manual", "local", "requires-kvm"],
    size = "medium",
    timeout = "moderate",
)

# === Host Validation ===

sh_test(
    name = "verify_tools",
    srcs = ["verify_tools.sh"],
    tags = ["manual", "local"],
    size = "small",
)

sh_test(
    name = "verify_permissions",
    srcs = ["verify_permissions.sh"],
    tags = ["manual", "local"],
    size = "small",
)

sh_test(
    name = "verify_network",
    srcs = ["verify_network.sh"],
    tags = ["manual", "local"],
    size = "small",
)

sh_test(
    name = "verify_host_deps",
    srcs = ["verify_host_deps.sh"],
    tags = ["manual", "local", "requires-host-tools"],
    size = "small",
)

test_suite(
    name = "vm_prerequisites",
    tests = [":verify_host_deps"],
    tags = ["manual", "local"],
)

# === Utility Scripts ===

sh_binary(
    name = "check_prerequisites",
    srcs = ["check_prerequisites.sh"],
)

sh_binary(
    name = "create_vm",
    srcs = ["create_test_vm.sh"],
    data = [],
)

sh_binary(
    name = "deploy_xibalba",
    srcs = ["deploy_xibalba.sh"],
    data = [
        "//chaos:pause_controller",
        "//chaos:pause_injector_bpf",
        "//chaos:simple_chaos_test",
    ],
)

sh_binary(
    name = "run_tests",
    srcs = ["run_tests.sh"],
)

sh_binary(
    name = "destroy_vm",
    srcs = ["destroy_vm.sh"],
)

