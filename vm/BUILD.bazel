# VM Infrastructure for Xibalba Testing
#
# Bazel-native VM testing: each filesystem gets its own test target,
# Bazel handles parallelism and result aggregation automatically.

package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
load(":vm_tests.bzl", "vm_gauntlet_suite")
load(":qemu_test.bzl", "qemu_filesystem_test", "qemu_filesystem_suite")

# === Hermetic Build Environment (Docker Container) ===

# Build tools container - provides all tools needed to build kernel/initramfs
# Developers don't need these tools installed - they run in the container!
oci_image(
    name = "build_tools",
    base = "@ubuntu_base",
    cmd = ["/bin/bash"],
    entrypoint = ["/bin/bash", "-c"],
)

# TODO: Install build tools in container (ar, tar, cpio, dpkg-deb, etc.)
# Will add via apt install once we test basic setup

# === Fast QEMU VM Testing Infrastructure ===

# Extract kernel and modules from Ubuntu packages (runs in container - hermetic!)
genrule(
    name = "extract_kernel_and_modules",
    srcs = ["build-scripts/extract-kernel.sh"],
    outs = ["vmlinuz", "kernel-modules.tar.gz"],
    cmd = """
        SCRIPT=$$(realpath $(location build-scripts/extract-kernel.sh))
        OUTPUT=$$(realpath $(@D))
        docker run --rm \
            -v $$SCRIPT:/extract.sh:ro \
            -v $$OUTPUT:/output \
            -e HOST_UID=$$(id -u) \
            -e HOST_GID=$$(id -g) \
            ubuntu:24.04 \
            bash -c 'apt-get update -qq && apt-get install -y -qq wget binutils xz-utils zstd && \
                     bash /extract.sh /output/vmlinuz /tmp/modules && \
                     cd /tmp/modules && tar czf /output/kernel-modules.tar.gz . && \
                     chown $$HOST_UID:$$HOST_GID /output/vmlinuz /output/kernel-modules.tar.gz'
    """,
    tags = ["docker", "requires-network", "local", "no-sandbox"],
)

# Legacy alias for compatibility
filegroup(
    name = "extract_kernel",
    srcs = [":vmlinuz"],
)

# Build minimal initramfs with filesystem tools, xibalba binaries, and kernel modules
genrule(
    name = "build_initramfs",
    srcs = [
        "build-scripts/build-initramfs.sh",
        "qemu/init.sh",
        "//chaos:pause_controller",
        "//chaos:simple_chaos_test",
        "//chaos:chaos_test_runner",  # NEW: Modular test runner
        "//chaos/injectors:rename_tracepoint_bpf",  # NEW: BPF programs
        "//chaos/injectors:link_tracepoint_bpf",
        ":xibalba-gauntlet.sh",
        ":kernel-modules.tar.gz",
    ],
    outs = ["initramfs.img"],
    cmd = """
        SCRIPT=$$(realpath $(location build-scripts/build-initramfs.sh))
        INIT=$$(realpath $(location qemu/init.sh))
        PAUSE_CTRL=$$(realpath $(location //chaos:pause_controller))
        CHAOS_TEST=$$(realpath $(location //chaos:simple_chaos_test))
        CHAOS_RUNNER=$$(realpath $(location //chaos:chaos_test_runner))
        RENAME_BPF=$$(realpath $(location //chaos/injectors:rename_tracepoint_bpf))
        LINK_BPF=$$(realpath $(location //chaos/injectors:link_tracepoint_bpf))
        GAUNTLET=$$(realpath $(location :xibalba-gauntlet.sh))
        MODULES=$$(realpath $(location :kernel-modules.tar.gz))
        OUTPUT=$$(realpath $(@D))
        docker run --rm \
            -v $$SCRIPT:/build.sh:ro \
            -v $$INIT:/input/init.sh:ro \
            -v $$PAUSE_CTRL:/input/pause_controller:ro \
            -v $$CHAOS_TEST:/input/simple_chaos_test:ro \
            -v $$CHAOS_RUNNER:/input/chaos_test_runner:ro \
            -v $$RENAME_BPF:/input/rename_tracepoint.bpf.o:ro \
            -v $$LINK_BPF:/input/link_tracepoint.bpf.o:ro \
            -v $$GAUNTLET:/input/xibalba-gauntlet:ro \
            -v $$MODULES:/input/kernel-modules.tar.gz:ro \
            -v $$OUTPUT:/output \
            -e HOST_UID=$$(id -u) \
            -e HOST_GID=$$(id -g) \
            ubuntu:24.04 \
            bash -c 'apt-get update -qq && apt-get install -y -qq cpio gzip tar zstd kmod udev && bash /build.sh /input/init.sh /input/pause_controller /input/simple_chaos_test /input/chaos_test_runner /input/rename_tracepoint.bpf.o /input/link_tracepoint.bpf.o /input/xibalba-gauntlet /output/initramfs.img /input/kernel-modules.tar.gz && chown $$HOST_UID:$$HOST_GID /output/initramfs.img'
    """,
    tags = ["docker", "requires-network", "local", "no-sandbox"],
)

# QEMU test runner - launches VM with xibalba tests
# Binaries are embedded in initramfs, so we only need kernel + initramfs
sh_binary(
    name = "qemu_test_runner",
    srcs = ["qemu/run-qemu-test.sh"],
    data = [
        ":extract_kernel",
        ":build_initramfs",
    ],
)

# === Fast QEMU Tests (NEW - replaces slow SSH-based tests) ===

# Test suite - run all filesystems in parallel (Bazel handles parallelism)
# Each test boots a fresh VM in ~1 second, runs for 60 seconds, total ~61 seconds per test
# With Bazel parallelism, all tests run simultaneously!
qemu_filesystem_suite(
    name = "qemu_fast_tests",
    filesystems = ["ext4", "xfs", "btrfs"],
    duration = 60,
)

# ============================================================================
# Modular Chaos Testing (NEW)
# ============================================================================

# Test individual workloads without injection (baseline)
chaos_modular_test(
    name = "chaos_rename_baseline",
    workload = "rename",
    injector = "none",
    filesystem = "btrfs",
    duration = 60,
)

chaos_modular_test(
    name = "chaos_hardlink_baseline",
    workload = "hardlink",
    injector = "none",
    filesystem = "btrfs",
    duration = 60,
)

# Test with tracepoint injectors (should find bugs!)
chaos_modular_test(
    name = "chaos_rename_with_tracepoint",
    workload = "rename",
    injector = "rename_tracepoint",
    filesystem = "btrfs",
    duration = 120,
)

chaos_modular_test(
    name = "chaos_hardlink_with_link_injector",
    workload = "hardlink",
    injector = "link_tracepoint",
    filesystem = "btrfs",
    duration = 120,
)

# Test suite: All modular chaos tests
test_suite(
    name = "modular_chaos_tests",
    tests = [
        ":chaos_rename_baseline",
        ":chaos_hardlink_baseline",
        ":chaos_rename_with_tracepoint",
        ":chaos_hardlink_with_link_injector",
    ],
    tags = ["modular", "chaos", "manual"],
)

# ============================================================================
# Consistency Model Comparison Tests
# ============================================================================
# Test ext4 and ZFS with both POSIX and WEAK models to empirically validate:
# 1. Both have 0 bugs with --posix (POSIX compliance)
# 2. ZFS has fewer bugs than ext4 with --weak (COW advantage)

# ext4 POSIX compliance (should be 0 bugs)
qemu_filesystem_test(
    name = "ext4_posix_compliance",
    filesystem = "ext4",
    model = "posix",
    duration = 120,
    readers = 5,
    writers = 2,
)

# ext4 weak consistency (natural race windows)
qemu_filesystem_test(
    name = "ext4_weak_consistency",
    filesystem = "ext4",
    model = "weak",
    duration = 120,
    readers = 5,
    writers = 2,
)

# ZFS POSIX compliance (should be 0 bugs)
qemu_filesystem_test(
    name = "zfs_posix_compliance",
    filesystem = "zfs",
    model = "posix",
    duration = 120,
    readers = 5,
    writers = 2,
)

# ZFS weak consistency (should have fewer bugs than ext4)
qemu_filesystem_test(
    name = "zfs_weak_consistency",
    filesystem = "zfs",
    model = "weak",
    duration = 120,
    readers = 5,
    writers = 2,
)

# Test suite: Run all comparisons
test_suite(
    name = "consistency_model_comparison",
    tests = [
        ":ext4_posix_compliance",
        ":ext4_weak_consistency",
        ":zfs_posix_compliance",
        ":zfs_weak_consistency",
    ],
    tags = ["comparison", "research"],
)

# === Pre-built VM Image (Xibalba already installed) - OLD APPROACH ===

# Build a VM image with xibalba and all dependencies pre-installed
# This makes testing MUCH faster - just boot and run, no installation needed
genrule(
    name = "xibalba_vm_image",
    srcs = ["//packaging:xibalba-deb"],
    outs = ["xibalba-ready.qcow2"],
    cmd = """
        set -e
        
        # Download base Ubuntu image
        BASE_IMG=$$(mktemp)
        wget -q -O $$BASE_IMG https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
        
        # Copy to output
        cp $$BASE_IMG $@
        chmod 644 $@
        
        # Install xibalba and all dependencies using virt-customize
        # This runs once at build time, not every test run!
        virt-customize -a $@ \
            --install libbpf1,libelf1,jq \
            --install e2fsprogs,xfsprogs,btrfs-progs,zfsutils-linux \
            --install f2fs-tools,nilfs-tools,nfs-common \
            --copy-in $(location //packaging:xibalba-deb):/tmp \
            --run-command 'dpkg -i /tmp/xibalba_0.1.0_amd64.deb' \
            --run-command 'rm /tmp/xibalba_0.1.0_amd64.deb' \
            --run-command 'systemctl disable snapd.service snapd.socket 2>/dev/null || true' \
            --run-command 'systemctl mask snapd.service snapd.socket 2>/dev/null || true' \
            --run-command 'apt-get clean' \
            --run-command 'rm -rf /var/lib/apt/lists/*'
        
        rm $$BASE_IMG
    """,
    tags = ["manual", "local", "requires-virt-customize"],
    message = "Building VM image with Xibalba pre-installed",
)

