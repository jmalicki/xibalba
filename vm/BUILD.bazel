# VM Infrastructure for Xibalba Testing
#
# These scripts create, manage, and test VMs for kernel filesystem testing.
# Run them via Bazel to ensure proper dependency tracking and hermetic execution.

package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

# Automated test runner (gets installed in VMs as /usr/bin/xibalba-test-runner)
sh_binary(
    name = "test_runner_script",
    srcs = ["test-runner.sh"],
    data = [],
)

# Gauntlet test runner - progressive consistency testing across all filesystems
sh_binary(
    name = "gauntlet_script",
    srcs = ["xibalba-gauntlet.sh"],
    data = [],
)

# Parallel VM test runner with automatic validation
# Validates host dependencies, then runs progressive gauntlet on multiple VMs
#
# Usage:
#   bazel test //vm:parallel_vm_tests_validated  # Preferred: validation + execution
#   bazel run //vm:parallel_vm_tests              # Direct execution (no validation)
sh_test(
    name = "parallel_vm_tests_validated",
    srcs = ["run_vm_tests_validated.sh"],
    args = ["$(location //packaging:xibalba-deb)"],
    data = [
        ":verify_host_deps.sh",
        ":run-parallel-vm-tests-wrapper.sh",
        ":run-parallel-vm-tests.sh",
        ":create_test_vm.sh",
        ":deploy_xibalba.sh",
        ":run_tests.sh",
        ":destroy_vm.sh",
        "//packaging:xibalba-deb",
    ],
    tags = ["manual", "local", "requires-kvm"],
    size = "large",  # VM tests take time
    timeout = "long",  # 15+ minutes
)

# Quick smoke test for VM infrastructure (~2 minutes)
# Validates: VM boot, package install, filesystem setup, test execution
sh_test(
    name = "vm_smoke_test",
    srcs = ["run-vm-smoke-test.sh"],
    args = ["$(location //packaging:xibalba-deb)"],
    data = [
        ":verify_host_deps.sh",
        ":create_test_vm.sh",
        ":deploy_xibalba.sh",
        ":xibalba-smoke-test.sh",
        ":destroy_vm.sh",
        "//packaging:xibalba-deb",
    ],
    tags = ["manual", "local", "requires-kvm"],
    size = "medium",
    timeout = "moderate",  # ~2 minutes
)

# Direct VM test runner (no automatic validation)
# Use parallel_vm_tests_validated instead for safety
sh_binary(
    name = "parallel_vm_tests",
    srcs = ["run-parallel-vm-tests-wrapper.sh"],
    args = ["$(location //packaging:xibalba-deb)"],
    data = [
        ":run-parallel-vm-tests.sh",
        ":create_test_vm.sh",
        ":deploy_xibalba.sh",
        ":run_tests.sh",
        ":destroy_vm.sh",
        "//packaging:xibalba-deb",
    ],
    tags = ["manual", "local", "requires-kvm"],
)

# Lightweight host dependency verification (Bazel test)
# This runs automatically as a dependency of VM operations
# Individual verification tests
sh_test(
    name = "verify_tools",
    srcs = ["verify_tools.sh"],
    tags = ["manual", "local"],
    size = "small",
)

sh_test(
    name = "verify_permissions",
    srcs = ["verify_permissions.sh"],
    tags = ["manual", "local"],
    size = "small",
)

sh_test(
    name = "verify_network",
    srcs = ["verify_network.sh"],
    tags = ["manual", "local"],
    size = "small",
)

# Combined verification (runs all checks)
sh_test(
    name = "verify_host_deps",
    srcs = ["verify_host_deps.sh"],
    tags = ["manual", "local", "requires-host-tools"],
    size = "small",
)

# Test suite that validates host first, then allows VM tests
# This ensures verify_host_deps passes before VM operations
test_suite(
    name = "vm_prerequisites",
    tests = [":verify_host_deps"],
    tags = ["manual", "local"],
)

# Check if host has required VM tools (QEMU/KVM, libvirt, etc.)
# More comprehensive than verify_host_deps
sh_binary(
    name = "check_prerequisites",
    srcs = ["check_prerequisites.sh"],
    # This can run standalone, no dependencies
)

# Create a test VM
# Usage: bazel run //vm:create_vm -- --name test-01 [--memory 4096] [--cpus 2]
sh_binary(
    name = "create_vm",
    srcs = ["create_test_vm.sh"],
    data = [
        # Will need cloud-init configs, kernel images, etc.
        # Add as we create them
    ],
)

# Deploy Xibalba binaries to a running VM
# Usage: bazel run //vm:deploy_xibalba -- <vm-name>
sh_binary(
    name = "deploy_xibalba",
    srcs = ["deploy_xibalba.sh"],
    data = [
        "//chaos:pause_controller",
        "//chaos:pause_injector_bpf",
        "//chaos:simple_chaos_test",
    ],
    # The script will copy binaries from bazel-bin/ to VM
)

# Run Xibalba tests inside a VM
# Usage: bazel run //vm:run_tests -- <vm-name>
sh_binary(
    name = "run_tests",
    srcs = ["run_tests.sh"],
    # Depends on deploy_xibalba being run first
)

# Destroy a test VM
# Usage: bazel run //vm:destroy_vm -- <vm-name>
sh_binary(
    name = "destroy_vm",
    srcs = ["destroy_vm.sh"],
)

