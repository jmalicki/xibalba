# VM Base Images for Testing
#
# Create reusable VM base images with all dependencies pre-installed.
# Build once, clone for each filesystem test.

package(default_visibility = ["//visibility:public"])

# Base VM image with all dependencies installed
# This is built ONCE and reused for all filesystem tests
genrule(
    name = "base_vm_image",
    srcs = [],
    outs = ["xibalba-base.qcow2"],
    cmd = """
        # Download Ubuntu cloud image
        wget -q -O /tmp/ubuntu-cloud.qcow2 \
            https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img
        
        # Install dependencies using virt-customize
        virt-customize -a /tmp/ubuntu-cloud.qcow2 \
            --install qemu-guest-agent,linux-image-generic,libbpf-dev,libbpf0,libelf1 \
            --run-command 'systemctl enable qemu-guest-agent' \
            --root-password password:xibalba \
            --ssh-inject root
        
        # Copy to output
        cp /tmp/ubuntu-cloud.qcow2 $@
    """,
    tags = [
        "requires-vm",
        "requires-root",  # virt-customize needs root
        "manual",  # Don't build automatically
    ],
)

# Clone base image for each filesystem
genrule(
    name = "ext4_vm_image",
    srcs = [":base_vm_image"],
    outs = ["xibalba-ext4.qcow2"],
    cmd = "qemu-img create -f qcow2 -F qcow2 -b $(location :base_vm_image) $@",
    tags = ["requires-vm", "manual"],
)

genrule(
    name = "xfs_vm_image", 
    srcs = [":base_vm_image"],
    outs = ["xibalba-xfs.qcow2"],
    cmd = "qemu-img create -f qcow2 -F qcow2 -b $(location :base_vm_image) $@",
    tags = ["requires-vm", "manual"],
)

genrule(
    name = "btrfs_vm_image",
    srcs = [":base_vm_image"],
    outs = ["xibalba-btrfs.qcow2"],
    cmd = "qemu-img create -f qcow2 -F qcow2 -b $(location :base_vm_image) $@",
    tags = ["requires-vm", "manual"],
)

genrule(
    name = "tmpfs_vm_image",
    srcs = [":base_vm_image"],
    outs = ["xibalba-tmpfs.qcow2"],
    cmd = "qemu-img create -f qcow2 -F qcow2 -b $(location :base_vm_image) $@",
    tags = ["requires-vm", "manual"],
)

# Convenience target to build all VM images
filegroup(
    name = "all_vm_images",
    srcs = [
        ":ext4_vm_image",
        ":xfs_vm_image",
        ":btrfs_vm_image",
        ":tmpfs_vm_image",
    ],
)

